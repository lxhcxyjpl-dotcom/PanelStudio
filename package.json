{
  "name": "panelstudio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" typecheck",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" --if-present test",
    "test:e2e": "playwright test -c apps/web/playwright.config.ts",
    "build:web": "pnpm --filter @panelstudio/web build",
    "test:e2e": "playwright test -c apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@resvg/resvg-js",
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
